# Attach a normal .ps script to a Scene Object and press Play.
# Custom Components are registered with PStudioECS for the duration of Play.

component EnemyAI
    speed = 3.0
    health = 100

system MoveEnemy(Transform, EnemyAI)
    transform.x += enemy_ai.speed * dt
    if enemy_ai.health <= 0
        transform.y = 0

system Regenerate(EnemyAI)
    if enemy_ai.health < 100
        enemy_ai.health += 1
