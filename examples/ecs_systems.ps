# Attach this .ps script to a Scene Object and press Play.
# In the ECS Inspector, add EnemyAI only to the Scene Objects that should run these Systems.
# New Scene Objects use explicit Component assignment; older scenes without ecsComponents keep legacy attach-all behavior.

component EnemyAI
    speed = 3.0
    health = 100

system MoveEnemy(Transform, EnemyAI)
    transform.x += enemy_ai.speed * dt
    if enemy_ai.health <= 0
        transform.y = 0

system Regenerate(EnemyAI)
    if enemy_ai.health < 100
        enemy_ai.health += 1
