attack_timer = 0

func start()
    physics_body(0, 2.4, 0, 0.38, 1.8, 1)
    set_gravity(0, -18, 0)
    character_controller(5.5, 28, 0.28)

func update(dt)
    # move_character は現在の3Dカメラの向きを基準に移動します。
    # カメラを回転させると、WASD / ジョイスティックの進行方向も連動します。
    move_character(get_axis("horizontal"), get_axis("vertical"))

    # 0.12秒の入力バッファとコヨーテタイムを使ったジャンプ。
    if was_key_pressed("space")
        jump(7.5)

    if was_key_pressed("f")
        play_animation_once("Attack")
        attack_timer = 0.65

    if attack_timer > 0
        attack_timer -= dt
    else
        # GLB内のクリップ名に合わせて変更してください。
        character_animation("Idle", "Walk", "Run", "Jump", "Fall", "Land")

    set_material(0.48, 0.06)
    load_model("Traveler.glb", get_x(), get_y() - 0.9, get_z(), 1)

    # 物理移動と同期したカメラ追従。障害物があれば自動で手前に補正されます。
    set_camera_follow(get_x() + 4, get_y() + 3, get_z() + 6, get_x(), get_y(), get_z(), 8)
